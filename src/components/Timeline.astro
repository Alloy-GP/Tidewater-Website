---
const events = [
  { year: '1989', title: 'Tidewater is founded', body: 'Stanley Greenberg starts the company in Owings Mills, Maryland — initially serving commercial condominium associations and developer-phase communities.', tag: 'Founded' },
  { year: 'Late 1990', title: 'Marc Greenberg joins', body: 'Stanley\'s son joins the firm, expanding focus into homeowner-controlled HOA management. The first multi-county portfolio takes shape.', tag: 'Generation II' },
  { year: '2000', title: 'Regional expansion', body: 'Operations extend across Maryland, into DC and Northern Virginia, then to the Eastern Shore and Delaware. The company grows past 100 communities under management.' },
  { year: '2012', title: 'Joe Jordan elected CAI Chesapeake Chapter President', body: 'Tidewater\'s Director of Quality Assurance leads the regional CAI chapter — beginning a sustained pattern of Tidewater leaders shaping the standards of the profession.' },
  { year: '2010', title: 'AAMC® Accreditation earned', body: 'Tidewater earns CAI\'s highest company-level credential — a designation most regional management firms do not hold.', tag: 'Highest credential' },
  { year: '2019', title: 'Ocean City office opens', body: 'Tidewater expands to the Maryland coast with a new Ocean City office, extending the Delmarva portfolio into Worcester County and the resort community market.' },
  { year: '2019–2024', title: 'Gail Windisch leads the Chesapeake Chapter', body: 'Senior Director of Operations Gail Windisch serves two consecutive terms on the CAI Chesapeake Chapter board &mdash; Secretary (2019), President-Elect (2020), President (2021), then re-elected as Secretary (2022), Vice President (2023), and Member at Large (2024) &mdash; making Tidewater one of the most embedded firms in regional CAI leadership.' },
  { year: '2020', title: 'Delaware expansion', body: 'Tidewater acquires a Delaware-based portfolio, adding coastal Delaware communities to its footprint and extending the Delmarva operation into Sussex and Kent counties.' },
  { year: '2024', title: 'Quality Assurance & Compliance team formalized', body: 'A dedicated QA and Compliance department is established under the leadership of former CAI Chesapeake Chapter President Joe Jordan — tracking insurance, safety inspections, tax filings, and budget cadences across every community in the portfolio.' },
  { year: 'Today', title: '450+ communities. ~75 in-house staff. Independent.', body: 'Manage 450+ associations and thousands of homes across six states. AAMC®, A+ BBB. Two CAI Chapter Presidents on staff. Still owned by Stanley and Marc.', tag: 'Still here' },
];
---
<section class="tw-section tw-section-linen tw-timeline-section" id="timeline">
  <div class="tw-container">
    <div class="tw-section-head-left">
      <div class="tw-eyebrow">35+ years, in order</div>
      <h2 class="tw-section-title">A timeline you can verify. <em>Most competitors can&rsquo;t.</em></h2>
      <p class="tw-section-lede">Independent operation isn&rsquo;t a bullet point — it&rsquo;s 35+ years of continuous decisions to stay that way.</p>
    </div>

    <ol class="tw-timeline">
      {events.map((e) => (
        <li class="tw-timeline-item">
          <div class="tw-timeline-rail">
            <span class="tw-timeline-dot"></span>
          </div>
          <div class="tw-timeline-card">
            <div class="tw-timeline-meta">
              <span class="tw-timeline-year">{e.year}</span>
              {e.tag && <span class="tw-timeline-tag">{e.tag}</span>}
            </div>
            <h3 class="tw-timeline-title">{e.title}</h3>
            <p class="tw-timeline-body"><Fragment set:html={e.body} /></p>
          </div>
        </li>
      ))}
    </ol>
  </div>
</section>
