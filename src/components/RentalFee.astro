---
// Two distinct service groups — the client was clear these are NOT one fee:
//  • Leasing / Pre-Tenant Services = a SEPARATE, one-time cost
//  • Management Services           = the monthly all-inclusive fee
// Pricing is intentionally left as a "contact us" item (no figures on-page).
const leasing = [
  'Complete property walk-through to suggest items to address ahead of advertising &amp; to collect pertinent information on the property to better serve you and the tenant',
  'Provide estimates from licensed and insured vendors for repairs &amp; renovations needed to prepare the home for leasing, Lead Certification or County/City License (if applicable)',
  'Provide a market analysis of market rent value with comparable homes and amenities',
  'Schedule Lead Inspection &amp; County/City Inspection for licensing (if applicable)',
  'Complete and track Lead Certifications &amp; County or City Rental Licenses (if applicable)',
  'Set up an active owner account with owner portal and owner reserve account',
  'Apply for mailing address change for utility service bills (if applicable)',
  'Take marketing photos, virtual tour video, and place a &ldquo;For Rent&rdquo; sign (if applicable)',
  'Advertise the property on 30&ndash;35 listing sites including Zillow, HotPads, Apartments.com, Lovely, PadMapper and more',
  'Ability to advertise through the MLS with our real estate brokerage, Tidewater Realty Group',
  'Pre-screen client leads and schedule in-person and video showings',
  'Process client applications &mdash; credit, criminal &amp; rental background, employment verification, and rental verification',
  'Prepare the lease agreement and lease addendums in ordinance with local, state, and county laws and regulations',
  'Provide the approved client a welcome letter with lease terms and utility service information',
  'Complete a comprehensive multi-page move-in inspection report with date-stamped photos of the property',
  'Collect and ensure compliance of lease terms &mdash; security deposit or Rhino account, renters insurance, and utility accounts',
];

const management = [
  'Rent collection and tenant account management',
  'Failure-to-pay-rent and eviction management',
  'Tenant communication &mdash; notices, reminders, questions and concerns',
  'Maintenance management &mdash; annual and emergency maintenance, plus tenant maintenance requests',
  'Provide licensed and insured vendors for maintenance, or work with your selected vendor(s) or Home Warranty policy',
  'Provide estimates for maintenance over the maintenance reserve limit',
  '24-hour on-call maintenance line and maintenance portal through AppFolio',
  'Property inspections &mdash; 3 months after a new move-in, then bi-annual inspections with photos',
  'HOA and Condo Association compliance management',
  'Utility service bill-back (if applicable)',
  'Tracking and renewal of Lead Certifications &amp; City/County Rental Licenses',
  'Landlord and tenant online portals &mdash; payments plus access to documents &amp; inspections',
  'Bill pay &mdash; mortgage, insurance, taxes, front-foot assessments, HOA or Condo Association',
  'Monthly owner distribution via ACH or check, with a monthly owner statement',
  'Year-end 1099 and statement',
  'Lease renewals &amp; addendums',
  'Complete a comprehensive multi-page move-out inspection report with date-stamped photos of the property',
  'Ensure compliance of lease terms including, but not limited to, professional property and carpet cleaning',
  'Provide estimates for turnover repairs needed to prepare the home for leasing',
];

const groups = [
  {
    kind: 'leasing',
    eyebrow: 'Leasing / Pre-Tenant Services',
    title: 'Getting your property rent-ready and leased',
    badge: 'Separate one-time cost',
    lede: 'A one-time service to prepare, market, and lease your property &mdash; priced separately from monthly management.',
    items: leasing,
  },
  {
    kind: 'mgmt',
    eyebrow: 'Management Services',
    title: 'Everything we handle once a tenant is in',
    badge: 'Included in your monthly fee',
    lede: 'Your flat monthly management fee &mdash; no per-visit, per-inspection, or per-coordination line items.',
    items: management,
  },
];
---
<section class="tw-section tw-section-linen" id="fee">
  <div class="tw-container">
    <div class="tw-section-head">
      <div class="tw-eyebrow">Leasing vs. Management &mdash; What&rsquo;s Separate, What&rsquo;s Included</div>
      <h2 class="tw-section-title">Two stages, priced honestly. <em>Leasing up front, management monthly.</em></h2>
      <p class="tw-section-lede">Leasing and tenant placement is a one-time service, billed separately from your flat monthly management fee. Here&rsquo;s exactly what each one covers &mdash; pricing is quick to walk through, just ask our rental team.</p>
    </div>

    <div class="tw-rsvc-groups">
      {groups.map((g) => (
        <div class={`tw-rsvc-group tw-rsvc-${g.kind}`}>
          <div class="tw-rsvc-group-head">
            <div class="tw-rsvc-group-headings">
              <div class="tw-rsvc-group-eyebrow">{g.eyebrow}</div>
              <h3 class="tw-rsvc-group-title"><Fragment set:html={g.title} /></h3>
            </div>
            <span class="tw-rsvc-badge"><Fragment set:html={g.badge} /></span>
          </div>
          <p class="tw-rsvc-group-lede"><Fragment set:html={g.lede} /></p>
          <ul class="tw-rsvc-list">
            {g.items.map((it) => (
              <li>
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3"><polyline points="20 6 9 17 4 12"/></svg>
                <span><Fragment set:html={it} /></span>
              </li>
            ))}
          </ul>
        </div>
      ))}
    </div>

    <p class="tw-tier-foot">Available as full management, leasing-only, or vacancy management. <a href="/request-a-proposal">Talk to our rental team about pricing &rarr;</a></p>
  </div>
</section>

<style>
  .tw-rsvc-groups {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 24px;
    align-items: start;
  }
  .tw-rsvc-group {
    background: var(--tw-cream);
    border: 1px solid var(--tw-border);
    border-radius: 16px;
    padding: 28px 28px 30px;
    border-top: 4px solid var(--tw-gold);
  }
  .tw-rsvc-group.tw-rsvc-mgmt { border-top-color: var(--tw-teal); }
  .tw-rsvc-group-head {
    display: flex;
    align-items: flex-start;
    justify-content: space-between;
    gap: 14px;
    margin-bottom: 6px;
  }
  .tw-rsvc-group-eyebrow {
    font-family: var(--tw-font-heading);
    font-size: 12px;
    font-weight: 700;
    letter-spacing: .1em;
    text-transform: uppercase;
    color: var(--tw-gold);
    margin-bottom: 6px;
  }
  .tw-rsvc-mgmt .tw-rsvc-group-eyebrow { color: var(--tw-teal); }
  .tw-rsvc-group-title {
    font-family: var(--tw-font-heading);
    font-size: clamp(1.25rem, 2vw, 1.5rem);
    font-weight: 700;
    color: var(--tw-dark);
    line-height: 1.2;
    margin: 0;
  }
  .tw-rsvc-badge {
    flex-shrink: 0;
    font-family: var(--tw-font-heading);
    font-size: 11px;
    font-weight: 700;
    letter-spacing: .04em;
    text-transform: uppercase;
    color: #8a7a3d;
    background: rgba(191, 172, 95, 0.16);
    border: 1px solid rgba(191, 172, 95, 0.35);
    border-radius: 999px;
    padding: 6px 12px;
    white-space: nowrap;
  }
  .tw-rsvc-mgmt .tw-rsvc-badge {
    color: var(--tw-teal-700, #1B4E59);
    background: var(--tw-teal-50, #EAF3F5);
    border-color: var(--tw-teal-100, #C7E0E5);
  }
  .tw-rsvc-group-lede {
    font-family: var(--tw-font-body);
    font-size: .95rem;
    line-height: 1.55;
    color: var(--tw-fg-muted);
    margin: 0 0 20px;
    max-width: 44ch;
  }
  .tw-rsvc-list {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    gap: 13px 22px;
  }
  .tw-rsvc-list li {
    display: flex;
    align-items: flex-start;
    gap: 10px;
    font-family: var(--tw-font-body);
    font-size: .92rem;
    line-height: 1.45;
    color: var(--tw-dark);
  }
  .tw-rsvc-list li svg {
    flex-shrink: 0;
    width: 16px;
    height: 16px;
    margin-top: 3px;
    color: var(--tw-gold);
  }
  .tw-rsvc-mgmt .tw-rsvc-list li svg { color: var(--tw-teal); }
  @media (max-width: 900px) {
    .tw-rsvc-groups { grid-template-columns: 1fr; }
  }
</style>
