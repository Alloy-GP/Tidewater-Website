---
// The Library — real articles & guides, pulled from the shared blog data
// (ALL_POSTS). No placeholders: every card links to a published article.
// Built to grow: when downloadable checklists, templates, and webinars become
// real, add them here as additional item types (type: 'checklist' | 'download'
// | 'video') alongside the articles.
import { ALL_POSTS } from './BlogPostsData.js';

const stripTags = (s: string) => String(s).replace(/<[^>]+>/g, '');
const audFor = (catId?: string) => (catId === 'rental' ? ['Rental'] : ['HOA']);

const items = [...ALL_POSTS]
  .sort((a, b) => String(b.dateIso || '').localeCompare(String(a.dateIso || '')))
  .map((p) => ({
    type: 'article',
    time: `${p.readTime} min read`,
    title: stripTags(p.title),
    desc: p.dek,
    href: p.href,
    aud: audFor(p.category?.id),
  }));

const audClass = (a: string) => {
  if (a === 'HOA') return 'tw-rseason-pub-aud hoa';
  if (a === 'Rental') return 'tw-rseason-pub-aud rental';
  if (a === 'Maintenance') return 'tw-rseason-pub-aud maint';
  if (a === 'Investor') return 'tw-rseason-pub-aud realty';
  return 'tw-rseason-pub-aud';
};
---
<section class="tw-rlib" id="library">
  <div class="tw-container">
    <div class="tw-section-head-left">
      <div class="tw-eyebrow">The Library</div>
      <h2 class="tw-section-title">Written by managers, <em>not marketing.</em></h2>
      <p class="tw-section-lede">Practical articles and guides from Tidewater&rsquo;s managers &mdash; free to read, no gate, no sales call. Downloadable checklists and templates are on the way.</p>
    </div>

    <div class="tw-rlib-grid">
      {items.map((r) => (
        <a href={r.href} class="tw-rlib-card" style="text-decoration:none;color:inherit">
          <div class="tw-rlib-card-meta">
            <span class={`tw-rlib-card-type ${r.type}`}>{r.type}</span>
            <span class="tw-rlib-card-time">{r.time}</span>
          </div>
          <h3 class="tw-rlib-card-title">{r.title}</h3>
          <p class="tw-rlib-card-desc">{r.desc}</p>
          <div class="tw-rlib-card-foot">
            <div class="tw-rlib-card-aud">
              {r.aud.map((a) => (
                <span class={audClass(a)} style="padding:3px 8px;font-size:10px">{a}</span>
              ))}
            </div>
            <span class="tw-rlib-card-link">Read &rarr;</span>
          </div>
        </a>
      ))}
    </div>
  </div>
</section>
