---
import BaseLayout from '../../../layouts/BaseLayout.astro';
import Topbar from '../../../components/Topbar.astro';
import Header from '../../../components/Header.astro';
import Breadcrumb from '../../../components/Breadcrumb.astro';
import Footer from '../../../components/Footer.astro';
import CTA from '../../../components/CTA.astro';
import RentalGeo, { GEO_DATA_HOWARD_COUNTY as geo } from '../../../components/RentalGeo.jsx';
import { breadcrumbSchema, serviceSchema, faqSchema, localBusinessSchema } from '../../../lib/schema';
import { SITE } from '../../../config/site';

const pageUrl = `${SITE.url}/rental-management/maryland/howard-county`;

const schemas = [
  serviceSchema({
    name: 'Rental Property Management — Howard County, MD',
    description: geo.schemaDesc,
    url: pageUrl,
    areaServed: 'Howard County, Maryland',
  }),
  breadcrumbSchema([
    { name: 'Home', url: SITE.url + '/' },
    { name: 'Rental Management', url: SITE.url + '/rental-management' },
    { name: 'Maryland', url: SITE.url + '/rental-management/maryland' },
    { name: 'Howard County', url: pageUrl },
  ]),
  faqSchema(geo.faqs),
  localBusinessSchema({
    office: 'hq',
    url: pageUrl,
    areaServed: { name: 'Howard County', type: 'AdministrativeArea', containedIn: 'Maryland' },
    description: geo.schemaDesc,
  }),
];
---

<BaseLayout
  title="Property Management in Howard County, MD | Tidewater"
  description="Property management in Howard County, MD — Columbia, Ellicott City, Elkridge, Clarksville. Columbia village rules navigated, county rental license handled. Flat 8.5% fee, no placement upcharge."
  ogType="website"
  pageSchema={schemas}
  pageStylesheet="styles-geo.css"
>
  <Topbar />
  <Header activeNav="rental" logoSrc="/assets/Tidewater-Management-Logo.svg" logoAlt="Tidewater Management" />
  <Breadcrumb variant="management" crumbs={[
    { label: 'Rental Management', href: '/rental-management' },
    { label: 'Maryland', href: '/rental-management/maryland' },
    { label: 'Howard County' },
  ]} />
  <RentalGeo geo={geo} client:load />
  <CTA />
  <Footer />
</BaseLayout>
