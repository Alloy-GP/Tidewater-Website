---
import BaseLayout from '../../../layouts/BaseLayout.astro';
import Topbar from '../../../components/Topbar.astro';
import Header from '../../../components/Header.astro';
import Breadcrumb from '../../../components/Breadcrumb.astro';
import Footer from '../../../components/Footer.astro';
import CTA from '../../../components/CTA.astro';
import RentalGeo, { GEO_DATA_OCEAN_CITY as geo } from '../../../components/RentalGeo.jsx';
import { breadcrumbSchema, serviceSchema, faqSchema, localBusinessSchema } from '../../../lib/schema';
import { SITE } from '../../../config/site';

const pageUrl = `${SITE.url}/rental-management/maryland/ocean-city`;

const schemas = [
  serviceSchema({
    name: 'Rental Property Management — Ocean City, MD',
    description: geo.schemaDesc,
    url: pageUrl,
    areaServed: 'Ocean City, Maryland',
  }),
  breadcrumbSchema([
    { name: 'Home', url: SITE.url + '/' },
    { name: 'Rental Management', url: SITE.url + '/rental-management' },
    { name: 'Maryland', url: SITE.url + '/rental-management/maryland' },
    { name: 'Ocean City', url: pageUrl },
  ]),
  faqSchema(geo.faqs),
  localBusinessSchema({
    office: 'oceanCity',
    url: pageUrl,
    areaServed: { name: 'Ocean City', type: 'City', containedIn: 'Maryland' },
    description: geo.schemaDesc,
  }),
];
---

<BaseLayout
  title="Ocean City Property Management | Tidewater"
  description="Ocean City property management from Tidewater\'s office at 8101 Coastal Highway — condo and single-family rentals on the island, West OC, Ocean Pines and Berlin. Town rental license handled."
  ogType="website"
  pageSchema={schemas}
  pageStylesheet="styles-geo.css"
>
  <Topbar />
  <Header activeNav="rental" logoSrc="/assets/Tidewater-Management-Logo.svg" logoAlt="Tidewater Management" />
  <Breadcrumb variant="management" crumbs={[
    { label: 'Rental Management', href: '/rental-management' },
    { label: 'Maryland', href: '/rental-management/maryland' },
    { label: 'Ocean City' },
  ]} />
  <RentalGeo geo={geo} client:load />
  <CTA />
  <Footer />
</BaseLayout>
