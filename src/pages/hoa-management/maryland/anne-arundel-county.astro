---
import BaseLayout from '../../../layouts/BaseLayout.astro';
import Header from '../../../components/Header.astro';
import Topbar from '../../../components/Topbar.astro';
import Footer from '../../../components/Footer.astro';
import CTA from '../../../components/CTA.astro';
import FaqAccordion from '../../../components/FaqAccordion.astro';
import Breadcrumb from '../../../components/Breadcrumb.astro';
import { serviceSchema, breadcrumbSchema, faqSchema, localBusinessSchema } from '../../../lib/schema';
import { SITE } from '../../../config/site';

const pageUrl = SITE.url + '/hoa-management/maryland/anne-arundel-county';

const countyFaqs = [
  { q: 'How is HOA management different in Anne Arundel County vs. other Maryland counties?', a: "Three things stand out: (1) Waterfront density — Annapolis, Edgewater, and Mayo have a high concentration of waterfront condo associations with master-policy and dock-management complications most Maryland counties don\'t face. (2) Master-planned scale — Crofton and Odenton have layered HOAs with sub-associations. (3) State capital regulatory access — Annapolis is the seat of state government. Tidewater\'s Anne Arundel team is sized for all three." },
  { q: 'Do you serve all of Anne Arundel County?', a: 'Yes — from Linthicum and Glen Burnie in the north, to Annapolis and Severna Park in the center, down to Edgewater, Shady Side, and Deale in the south. Portfolios are capped at 8–12 communities per manager so site visits are scheduled around your community rather than squeezed in.' },
  { q: 'How quickly can you start managing our Anne Arundel community?', a: 'The controlling factor is the notice period in your current management agreement, not us. Once notice is served we work to a 30/60/90-day transition plan covering records, bank accounts, vendor assignment and the first reporting cycle. See the <a href="/solutions/switching-hoa-management-company">full transition timeline</a>.' },
  { q: "What\'s your fee structure for Anne Arundel HOAs?", a: 'It depends on community size, vendor count, meeting cadence and complexity, so we quote per association rather than publishing a rate card. <a href="/request-a-proposal">Request a proposal</a> and you will get a line-item number for your community. Boards that want professional books without full service can start at our <a href="/hoa-management/hoa-financial-management">financial-only tier</a>.' },
  { q: 'Can we talk to other Anne Arundel boards before signing?', a: "Always. We\'ll connect you with board presidents from comparable Anne Arundel communities — same size, similar stage, similar issues. You call them, no script." },
  { q: "What\'s your Anne Arundel office address?", a: 'Our headquarters is at 3600 Crondall Lane, Suite 100, Owings Mills, MD 21117, with a second Maryland office on Columbia Pike in Silver Spring. Main line: (443) 548-0191, with a 30-minute contractual callback guarantee after hours, answered by Tidewater managers rather than an answering service.' },
];

const schemas = [
  serviceSchema({
    name: 'HOA Management Anne Arundel County Maryland',
    description: 'AAMC-accredited HOA and condo association management across Anne Arundel County, Maryland — Annapolis, Severna Park, Crofton, Pasadena, Glen Burnie, and Odenton.',
    url: pageUrl,
    areaServed: 'Anne Arundel County, Maryland',
  }),
  breadcrumbSchema([
    { name: 'Home', url: SITE.url + '/' },
    { name: 'HOA Management', url: SITE.url + '/hoa-management' },
    { name: 'Maryland', url: SITE.url + '/hoa-management/maryland' },
    { name: 'Anne Arundel County', url: pageUrl },
  ]),
  faqSchema(countyFaqs),
  localBusinessSchema({
    office: 'hq',
    url: pageUrl,
    areaServed: { name: 'Anne Arundel County', type: 'AdministrativeArea', containedIn: 'Maryland' },
    description: 'AAMC-accredited HOA and condo association management across Anne Arundel County, Maryland — Annapolis, Severna Park, Crofton, Pasadena, Glen Burnie, and Odenton.',
  }),
];
---
<BaseLayout
  title="HOA Management Anne Arundel County Maryland — Tidewater"
  description="HOA and condo management in Anne Arundel County — Annapolis, Severna Park, Crofton, Pasadena, Glen Burnie, Odenton. AAMC-accredited regional manager."
  pageSchema={schemas}
>
  <style is:global>
    /* ensure React island styles reach DOM */
  </style>
  <Topbar variant="default" />
  <Header activeNav="mgmt" logoSrc="/assets/Tidewater-Management-Logo.svg" logoAlt="Tidewater Management" />
  <Breadcrumb variant="management" crumbs={[
    { label: 'HOA Management', href: '/hoa-management' },
    { label: 'Maryland', href: '/hoa-management/maryland' },
    { label: 'Anne Arundel County' },
  ]} />

  <!-- Hero -->
  <section class="tw-geo-hero">
    <div class="tw-geo-hero-bg"></div>
    <div class="tw-geo-hero-paper"></div>
    <div class="tw-geo-hero-grid">
      <div class="tw-geo-hero-copy">
        <h1 class="tw-geo-hero-title">
          HOA management in <em>Anne Arundel County.</em>
        </h1>
        <p class="tw-geo-hero-lede">
          From the Annapolis waterfront to the Severna Park corridor to Glen Burnie townhomes &mdash; Anne Arundel is Maryland&rsquo;s densest HOA county and one of our most active association markets. Family-owned since 1989, AAMC-accredited, and capped at 8&ndash;12 communities per manager so yours is known rather than numbered.
        </p>
        <div class="tw-geo-hero-actions">
          <a href="/request-a-proposal" class="tw-btn tw-btn-primary tw-btn-lg">Request a proposal &rarr;</a>
          <a href="#services" class="tw-btn tw-btn-ghost">See service tiers &rarr;</a>
        </div>
        <div class="tw-geo-hero-stats">
          <div>
            <div class="tw-geo-hero-stat-num">450+</div>
            <div class="tw-geo-hero-stat-label">Communities managed across six states</div>
          </div>
          <div>
            <div class="tw-geo-hero-stat-num gold">AAMC&reg;</div>
            <div class="tw-geo-hero-stat-label">CAI&rsquo;s highest company accreditation &middot; PCAM on staff</div>
          </div>
          <div>
            <div class="tw-geo-hero-stat-num">30-min</div>
            <div class="tw-geo-hero-stat-label">Contractual after-hours callback guarantee</div>
          </div>
        </div>
      </div>
      <aside class="tw-geo-hero-side">
        <div class="tw-geo-hero-side-eyebrow">In Anne Arundel</div>
        <h3>Where we manage</h3>
        <!-- Anne Arundel county SVG map -->
        <svg viewBox="0 0 360 290" class="tw-geo-map" xmlns="http://www.w3.org/2000/svg" aria-label="Map of Anne Arundel County">
          <!-- Chesapeake / waterfront on the right edge -->
          <path d="M295 85 Q320 130 320 180 Q315 220 305 240 L360 240 L360 50 L320 50 Z" fill="rgba(58,146,166,0.15)"/>
          <!-- County shape -->
          <path d="M40 50 L160 40 L240 55 L295 85 L320 145 L305 215 L260 250 L195 245 L130 220 L75 195 L45 135 Z" class="tw-geo-map-county served" style="cursor:default">
            <title>Anne Arundel County</title>
          </path>
          <!-- Glen Burnie -->
          <circle cx="130" cy="70" r="4.5" fill="var(--tw-teal)" stroke="var(--tw-cream)" stroke-width="1.5"><title>Glen Burnie</title></circle>
          <text x="140" y="74" fill="rgba(254,252,248,0.85)" font-family="var(--tw-font-heading)" font-weight="600" font-size="10" letter-spacing="0.02em">Glen Burnie</text>
          <!-- Pasadena -->
          <circle cx="210" cy="80" r="4.5" fill="var(--tw-teal)" stroke="var(--tw-cream)" stroke-width="1.5"><title>Pasadena</title></circle>
          <text x="220" y="84" fill="rgba(254,252,248,0.85)" font-family="var(--tw-font-heading)" font-weight="600" font-size="10" letter-spacing="0.02em">Pasadena</text>
          <!-- Severna Park -->
          <circle cx="240" cy="130" r="4.5" fill="var(--tw-teal)" stroke="var(--tw-cream)" stroke-width="1.5"><title>Severna Park</title></circle>
          <text x="250" y="134" fill="rgba(254,252,248,0.85)" font-family="var(--tw-font-heading)" font-weight="600" font-size="10" letter-spacing="0.02em">Severna Park</text>
          <!-- Annapolis (HQ dot) -->
          <circle class="tw-geo-map-dot-pulse" cx="270" cy="200" r="8"/>
          <circle cx="270" cy="200" r="6" fill="var(--tw-gold)" stroke="var(--tw-cream)" stroke-width="2"><title>Annapolis</title></circle>
          <text x="280" y="204" fill="rgba(254,252,248,0.85)" font-family="var(--tw-font-heading)" font-weight="800" font-size="11" letter-spacing="0.02em">Annapolis</text>
          <!-- Crofton -->
          <circle cx="100" cy="170" r="4.5" fill="var(--tw-teal)" stroke="var(--tw-cream)" stroke-width="1.5"><title>Crofton</title></circle>
          <text x="110" y="174" fill="rgba(254,252,248,0.85)" font-family="var(--tw-font-heading)" font-weight="600" font-size="10" letter-spacing="0.02em">Crofton</text>
          <!-- Odenton -->
          <circle cx="80" cy="110" r="4.5" fill="var(--tw-teal)" stroke="var(--tw-cream)" stroke-width="1.5"><title>Odenton</title></circle>
          <text x="90" y="114" fill="rgba(254,252,248,0.85)" font-family="var(--tw-font-heading)" font-weight="600" font-size="10" letter-spacing="0.02em">Odenton</text>
        </svg>
        <div class="tw-geo-map-legend">
          <div class="tw-geo-map-legend-row">
            <span class="tw-geo-map-legend-swatch served"></span>
            Cities &amp; towns we serve
          </div>
          <div class="tw-geo-map-legend-row">
            <span class="tw-geo-map-legend-swatch hq"></span>
            County seat &middot; Annapolis
          </div>
        </div>
      </aside>
    </div>
  </section>

  <!-- Neighborhoods / cities served -->
  <section class="tw-geo-section cream">
    <div class="tw-container-wide">
      <div class="tw-section-head" style="text-align:center;max-width:760px;margin:0 auto">
        <div class="tw-eyebrow">Where We Manage</div>
        <h2 class="tw-section-title">Anne Arundel cities &amp; towns <em>we serve.</em></h2>
        <p class="tw-section-lede">Most counties have one or two HOA-dense pockets. Anne Arundel has twelve. Here&rsquo;s where we&rsquo;re active.</p>
      </div>
      <div class="tw-geo-neighbors">
        <div class="tw-geo-neighbor">
          <div class="tw-geo-neighbor-name">Annapolis</div>
          <div class="tw-geo-neighbor-meta">Waterfront focus</div>
          <span class="tw-geo-neighbor-tag">County seat</span>
        </div>
        <div class="tw-geo-neighbor">
          <div class="tw-geo-neighbor-name">Severna Park</div>
          <div class="tw-geo-neighbor-meta">Single-family</div>
        </div>
        <div class="tw-geo-neighbor">
          <div class="tw-geo-neighbor-name">Crofton</div>
          <div class="tw-geo-neighbor-meta">Planned</div>
        </div>
        <div class="tw-geo-neighbor">
          <div class="tw-geo-neighbor-name">Pasadena</div>
          <div class="tw-geo-neighbor-meta">Mixed</div>
        </div>
        <div class="tw-geo-neighbor">
          <div class="tw-geo-neighbor-name">Glen Burnie</div>
          <div class="tw-geo-neighbor-meta">Townhome dense</div>
        </div>
        <div class="tw-geo-neighbor">
          <div class="tw-geo-neighbor-name">Odenton</div>
          <div class="tw-geo-neighbor-meta">New construction</div>
          <span class="tw-geo-neighbor-tag">Growing</span>
        </div>
        <div class="tw-geo-neighbor">
          <div class="tw-geo-neighbor-name">Arnold</div>
          <div class="tw-geo-neighbor-meta">Single-family</div>
        </div>
        <div class="tw-geo-neighbor">
          <div class="tw-geo-neighbor-name">Edgewater</div>
          <div class="tw-geo-neighbor-meta">Waterfront</div>
        </div>
        <div class="tw-geo-neighbor">
          <div class="tw-geo-neighbor-name">Linthicum</div>
          <div class="tw-geo-neighbor-meta">Transit hub</div>
        </div>
        <div class="tw-geo-neighbor">
          <div class="tw-geo-neighbor-name">Davidsonville</div>
          <div class="tw-geo-neighbor-meta">Rural HOA</div>
        </div>
        <div class="tw-geo-neighbor">
          <div class="tw-geo-neighbor-name">Mayo</div>
          <div class="tw-geo-neighbor-meta">Waterfront</div>
        </div>
        <div class="tw-geo-neighbor">
          <div class="tw-geo-neighbor-name">Shady Side</div>
          <div class="tw-geo-neighbor-meta">Seasonal</div>
        </div>
      </div>
    </div>
  </section>

  <!-- Local facts strip -->
  <section class="tw-geo-section linen" style="padding:64px 0">
    <div class="tw-container-wide">
      <div class="tw-section-head-left" style="max-width:760px;margin:0 0 12px">
        <div class="tw-eyebrow">By the Numbers</div>
        <h2 class="tw-section-title" style="margin:10px 0 14px">The Anne Arundel HOA landscape, <em>in data.</em></h2>
        <p class="tw-section-lede">Maryland&rsquo;s densest HOA county, governed by some of the most rigorous association law in the Mid-Atlantic.</p>
      </div>
      <div class="tw-geo-facts">
        <div class="tw-geo-fact">
          <div class="tw-geo-fact-label">Governing statute</div>
          <div class="tw-geo-fact-val">&sect; 11B</div>
          <div class="tw-geo-fact-sub">Maryland Homeowners Association Act &middot; Condo Act &sect; 11</div>
        </div>
        <div class="tw-geo-fact">
          <div class="tw-geo-fact-label">Reserve studies</div>
          <div class="tw-geo-fact-val">Required</div>
          <div class="tw-geo-fact-sub">Maryland law &middot; we fund to the study, not the developer schedule</div>
        </div>
        <div class="tw-geo-fact">
          <div class="tw-geo-fact-label">Communities per manager</div>
          <div class="tw-geo-fact-val">8&ndash;12</div>
          <div class="tw-geo-fact-sub">Portfolios capped on purpose</div>
        </div>
        <div class="tw-geo-fact">
          <div class="tw-geo-fact-label">After-hours callback</div>
          <div class="tw-geo-fact-val">30 <span class="gold">min</span></div>
          <div class="tw-geo-fact-sub">Contractual guarantee &middot; answered by Tidewater managers</div>
        </div>
      </div>
    </div>
  </section>

  <!-- Local manager card -->
  <section class="tw-geo-section cream" style="padding:64px 0">
    <div class="tw-container-wide">
      <div class="tw-section-head-left" style="max-width:760px;margin:0 0 12px">
        <div class="tw-eyebrow">Your Local Manager</div>
        <h2 class="tw-section-title" style="margin:10px 0 14px">A named regional team, <em>not a rotating pool.</em></h2>
        <p class="tw-section-lede">Same person at every board meeting. Same person at the vendor walk-through. Same person residents email.</p>
      </div>
      <div class="tw-geo-manager">
        <div class="tw-geo-manager-avatar">KC</div>
        <div>
          <div class="tw-geo-manager-eyebrow">Baltimore &amp; DC Metro Regional Director</div>
          <div class="tw-geo-manager-name">
            Kate Cornell <span>CMCA&reg;</span>
          </div>
          <p class="tw-geo-manager-role">
            Kate oversees the direction and professional development of the Community Association Management team out of the Owings Mills office, and co-leads the developer management program &mdash; the team that runs developer-controlled communities through to homeowner turnover. <strong>15+ years</strong> in the industry.
          </p>
        </div>
        <div style="display:flex;flex-direction:column;gap:8px;min-width:200px">
          <a href="/request-a-proposal" class="tw-btn tw-btn-primary tw-btn-block">Email Kate &rarr;</a>
          <a href="tel:+14435480191" class="tw-btn tw-btn-outline tw-btn-block">(443) 548-0191</a>
        </div>
      </div>
    </div>
  </section>

  <!-- Communities table -->

  <!-- Service callouts -->
  <section id="services" class="tw-geo-section linen">
    <div class="tw-container-wide">
      <div class="tw-section-head" style="text-align:center;max-width:760px;margin:0 auto">
        <div class="tw-eyebrow">Services in Anne Arundel</div>
        <h2 class="tw-section-title">Three service tiers, <em>same regional team.</em></h2>
        <p class="tw-section-lede">Pick the level of service your board needs &mdash; everything else stays the same.</p>
      </div>
      <div class="tw-geo-law-grid" style="margin-top:48px">
        <a href="/hoa-management" class="tw-geo-law-card" style="text-decoration:none">
          <h3>Full HOA Management</h3>
          <p>AAMC-accredited service for single-family, townhome, and master-planned HOAs. Includes financials, vendor management, covenant enforcement, board meetings, and 24/7 emergency response.</p>
          <div class="tw-geo-law-foot">Full-service details &rarr;</div>
        </a>
        <a href="/hoa-management#tiers" class="tw-geo-law-card gold" style="text-decoration:none">
          <h3>Flex Service</h3>
          <p>Lower base fee with &agrave;-la-carte involvement for established Anne Arundel boards. Includes full financial controls, owner portal, and 24/7 emergency coverage &mdash; without the standing on-site presence.</p>
          <div class="tw-geo-law-foot">Flex tier details &rarr;</div>
        </a>
        <a href="/hoa-management/hoa-financial-management" class="tw-geo-law-card sage" style="text-decoration:none">
          <h3>Financial Management Only</h3>
          <p>For self-managed boards in Anne Arundel that want CPA-led books without giving up operational control. Monthly statements, A/R, audit support, reserve study refresh.</p>
          <div class="tw-geo-law-foot">Financial-only tier &rarr;</div>
        </a>
      </div>
    </div>
  </section>

  <!-- FAQ section -->
  <section class="tw-section tw-sol-faq-section">
    <div class="tw-container-wide">
      <div class="tw-sol-faq-grid">
        <div class="tw-sol-faq-head">
          <div class="tw-eyebrow">Anne Arundel FAQs</div>
          <h2>The county-specific <em>questions</em> we get.</h2>
          <p>For all-purpose HOA questions see our <a href="/faq" style="color:var(--tw-teal-500);text-decoration:underline;text-underline-offset:3px">main FAQ hub</a>.</p>
          <a href="/request-a-proposal" class="tw-btn tw-btn-primary">Ask your own question &rarr;</a>
        </div>
        <FaqAccordion items={countyFaqs} defaultOpen={0} />
      </div>
    </div>
  </section>

  <!-- Nearby counties + related -->
  <section class="tw-geo-section mist" style="padding:64px 0">
    <div class="tw-container-wide">
      <div class="tw-section-head-left" style="max-width:760px;margin:0 0 12px">
        <div class="tw-eyebrow">Nearby Counties &amp; Related</div>
        <h2 class="tw-section-title" style="margin:10px 0 14px">We manage across the Mid-Atlantic.</h2>
      </div>
      <div class="tw-geo-law-grid">
        <a href="/hoa-management/maryland/howard-county" class="tw-geo-law-card" style="text-decoration:none"><h3>Howard County</h3><p>Columbia village associations, Ellicott City historic district, west-county developer transitions.</p><div class="tw-geo-law-foot">HOA management in Howard County &rarr;</div></a>
        <a href="/hoa-management/maryland/baltimore-county" class="tw-geo-law-card gold" style="text-decoration:none"><h3>Baltimore County</h3><p>Our home county &mdash; Towson, Owings Mills, Pikesville, Catonsville. Older stock, real reserves.</p><div class="tw-geo-law-foot">HOA management in Baltimore County &rarr;</div></a>
        <a href="/hoa-management/maryland/montgomery-county" class="tw-geo-law-card sage" style="text-decoration:none"><h3>Montgomery County</h3><p>CCOC registration, Chapter 10B, Bethesda and Silver Spring high-rise condominiums.</p><div class="tw-geo-law-foot">HOA management in Montgomery County &rarr;</div></a>
        <a href="/rental-management/maryland/anne-arundel-county" class="tw-geo-law-card clay" style="text-decoration:none"><h3>Anne Arundel rentals</h3><p>Single-family and small-multifamily rental management for owners inside the communities we manage.</p><div class="tw-geo-law-foot">Anne Arundel County property management &rarr;</div></a>
      </div>
      <p style="margin:24px 0 0;font-family:var(--tw-font-body);font-size:.95rem;color:var(--tw-fg-muted)">Also: <a href="/hoa-management/maryland/carroll-county" style="color:var(--tw-teal)">Carroll County</a>, <a href="/hoa-management/maryland/frederick-county" style="color:var(--tw-teal)">Frederick County</a>, and <a href="/hoa-management/maryland" style="color:var(--tw-teal)">all Maryland counties</a>.</p>
    </div>
  </section>

  <CTA />
  <Footer />
</BaseLayout>
