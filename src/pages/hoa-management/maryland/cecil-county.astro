---
// HOA Management — Cecil County, MD. Hand-built to the standard (tw-geo).
// Lead: Don Gentry (Delmarva — upper Eastern Shore / head of the bay).
// Self-canonical; wrong-audience cross-link to the rental hub (no Cecil rental
// page). See docs/county-page-playbook.md. Verified local context only.
import BaseLayout from '../../../layouts/BaseLayout.astro';
import Header from '../../../components/Header.astro';
import Topbar from '../../../components/Topbar.astro';
import Footer from '../../../components/Footer.astro';
import CTA from '../../../components/CTA.astro';
import FaqAccordion from '../../../components/FaqAccordion.astro';
import Breadcrumb from '../../../components/Breadcrumb.astro';
import { serviceSchema, breadcrumbSchema, faqSchema } from '../../../lib/schema';
import { SITE } from '../../../config/site';

const countyFaqs = [
  { q: 'Do you work with small waterfront associations?', a: 'Yes, and the waterfront part is the reason to plan early. Bulkheads, piers and shoreline are capital items with their own replacement cycle, and an association that has not modelled them into a reserve plan is usually one storm away from a special assessment.' },
  { q: 'How many communities will our manager be handling?', a: 'Manager portfolios are capped at <strong>8&ndash;12 communities</strong> &mdash; a hard ceiling, so a Cecil board gets a manager who knows its governing documents rather than one lost in an overloaded book.' },
  { q: 'What happens after hours?', a: 'Our emergency line is answered by Tidewater community managers on a rotating on-call schedule, not a third-party answering service. Callback standard is 20 minutes, <strong>contractually guaranteed at 30</strong>.' },
  { q: 'What does HOA management cost in Cecil County?', a: 'We quote per association rather than publishing a rate card, because cost tracks community size, vendor count, meeting cadence and complexity. <a href="/request-a-proposal">Request a proposal</a> for a line-item number, or start with the <a href="/hoa-management/hoa-financial-management">financial-only tier</a>.' },
  { q: 'How quickly can you take over our Cecil County community?', a: 'The notice period in your current management agreement sets the pace. From there we work to a <strong>30/60/90-day</strong> plan covering records, bank accounts, vendor assignment and the first reporting cycle &mdash; see the <a href="/solutions/switching-hoa-management-company">full transition timeline</a>.' },
];

const canonical = SITE.url + '/hoa-management/maryland/cecil-county';

const schemas = [
  serviceSchema({
    name: 'HOA Management Cecil County Maryland',
    description: 'AAMC-accredited HOA and condo association management across Cecil County, Maryland — Elkton, North East, Perryville, and Chesapeake City.',
    url: canonical,
    areaServed: 'Cecil County, Maryland',
  }),
  breadcrumbSchema([
    { name: 'Home', url: SITE.url + '/' },
    { name: 'HOA Management', url: SITE.url + '/hoa-management' },
    { name: 'Maryland', url: SITE.url + '/hoa-management/maryland' },
    { name: 'Cecil County', url: canonical },
  ]),
  faqSchema(countyFaqs),
];

const cities = [
  { name: 'Elkton',          meta: 'Townhome · single-family', tag: 'County seat' },
  { name: 'North East',      meta: 'Waterfront · single-family · head of the bay' },
  { name: 'Perryville',      meta: 'Single-family HOA · Susquehanna adjacency' },
  { name: 'Chesapeake City', meta: 'Small association · C&amp;D Canal · historic' },
  { name: 'Rising Sun',      meta: 'Single-family HOA · Pennsylvania line' },
  { name: 'Port Deposit',    meta: 'Small association · riverfront' },
];
---
<BaseLayout
  title="HOA Management Cecil County Maryland — Tidewater"
  description="HOA and condo management in Cecil County — Elkton, North East, Perryville, and Chesapeake City. AAMC-accredited, family-owned since 1989."
  pageSchema={schemas}
  pageStylesheet="styles-geo.css"
>
  <Topbar variant="default" />
  <Header activeNav="mgmt" logoSrc="/assets/Tidewater-Management-Logo.svg" logoAlt="Tidewater Management" />
  <Breadcrumb variant="management" crumbs={[
    { label: 'HOA Management', href: '/hoa-management' },
    { label: 'Maryland', href: '/hoa-management/maryland' },
    { label: 'Cecil County' },
  ]} />

  <section class="tw-geo-hero">
    <div class="tw-geo-hero-bg"></div>
    <div class="tw-geo-hero-paper"></div>
    <div class="tw-geo-hero-grid">
      <div class="tw-geo-hero-copy">
        <h1 class="tw-geo-hero-title">HOA management in <em>Cecil County.</em></h1>
        <p class="tw-geo-hero-lede">
          Cecil sits at the top of the Chesapeake between Maryland, Delaware and Pennsylvania, and its associations run smaller and more waterfront-exposed than most of our footprint. Family-owned since 1989, AAMC-accredited, with capped manager portfolios so yours is known rather than numbered.
        </p>
        <div class="tw-geo-hero-actions">
          <a href="/request-a-proposal" class="tw-btn tw-btn-primary tw-btn-lg">Request a proposal &rarr;</a>
          <a href="#communities" class="tw-btn tw-btn-ghost">See where we manage &rarr;</a>
        </div>
        <div class="tw-geo-hero-stats">
          <div><div class="tw-geo-hero-stat-num">450+</div><div class="tw-geo-hero-stat-label">Communities managed across six states</div></div>
          <div><div class="tw-geo-hero-stat-num gold">AAMC&reg;</div><div class="tw-geo-hero-stat-label">CAI&rsquo;s highest company accreditation &middot; PCAM on staff</div></div>
          <div><div class="tw-geo-hero-stat-num">1989</div><div class="tw-geo-hero-stat-label">Family-owned and operated &mdash; 35+ years in the Mid-Atlantic</div></div>
        </div>
      </div>
      <aside class="tw-geo-hero-side">
        <div class="tw-geo-hero-side-eyebrow">In Cecil County</div>
        <h3>Where we manage</h3>
        <svg viewBox="0 0 360 290" class="tw-geo-map" xmlns="http://www.w3.org/2000/svg" aria-label="Schematic map of Cecil County, Maryland">
          <path d="M104 52 Q168 44 214 60 L252 104 Q262 150 236 196 L198 236 Q160 232 142 198 L110 150 Q86 100 104 52 Z" class="tw-geo-map-county served" style="cursor:default"><title>Cecil County</title></path>
          <circle cx="170" cy="82" r="4.5" fill="var(--tw-teal)" stroke="var(--tw-cream)" stroke-width="1.5"><title>Rising Sun</title></circle>
          <text x="178" y="80" fill="rgba(254,252,248,0.85)" font-family="var(--tw-font-heading)" font-weight="600" font-size="10">Rising Sun</text>
          <circle class="tw-geo-map-dot-pulse" cx="196" cy="118" r="8"/>
          <circle cx="196" cy="118" r="6" fill="var(--tw-gold)" stroke="var(--tw-cream)" stroke-width="2"><title>Elkton</title></circle>
          <text x="206" y="122" fill="rgba(254,252,248,0.85)" font-family="var(--tw-font-heading)" font-weight="800" font-size="11">Elkton</text>
          <circle cx="130" cy="130" r="4.5" fill="var(--tw-teal)" stroke="var(--tw-cream)" stroke-width="1.5"><title>Port Deposit</title></circle>
          <text x="58" y="128" fill="rgba(254,252,248,0.85)" font-family="var(--tw-font-heading)" font-weight="600" font-size="10">Port Deposit</text>
          <circle cx="150" cy="170" r="4.5" fill="var(--tw-teal)" stroke="var(--tw-cream)" stroke-width="1.5"><title>Perryville</title></circle>
          <text x="78" y="174" fill="rgba(254,252,248,0.85)" font-family="var(--tw-font-heading)" font-weight="600" font-size="10">Perryville</text>
          <circle cx="188" cy="178" r="4.5" fill="var(--tw-teal)" stroke="var(--tw-cream)" stroke-width="1.5"><title>North East</title></circle>
          <text x="196" y="182" fill="rgba(254,252,248,0.85)" font-family="var(--tw-font-heading)" font-weight="600" font-size="10">North East</text>
          <circle cx="210" cy="206" r="4.5" fill="var(--tw-teal)" stroke="var(--tw-cream)" stroke-width="1.5"><title>Chesapeake City</title></circle>
          <text x="218" y="210" fill="rgba(254,252,248,0.85)" font-family="var(--tw-font-heading)" font-weight="600" font-size="10">Chesapeake City</text>
        </svg>
        <div class="tw-geo-map-legend">
          <div class="tw-geo-map-legend-row"><span class="tw-geo-map-legend-swatch served"></span>Cities &amp; towns we serve</div>
          <div class="tw-geo-map-legend-row"><span class="tw-geo-map-legend-swatch hq"></span>County seat &middot; Elkton</div>
        </div>
      </aside>
    </div>
  </section>

  <div class="tw-geo-section linen" style="padding:14px 0">
    <div class="tw-container-wide" style="text-align:center">
      <p style="margin:0;font-size:14px;color:var(--tw-fg-muted)">Managing a rental property in Cecil County? See <a href="/rental-management/maryland" style="color:var(--tw-teal-500);text-decoration:underline;text-underline-offset:3px">Tidewater rental management</a> instead &mdash; this page is for HOA &amp; condo association boards.</p>
    </div>
  </div>

  <section class="tw-geo-section cream">
    <div class="tw-container-wide">
      <div class="tw-section-head" style="text-align:center;max-width:760px;margin:0 auto">
        <div class="tw-eyebrow">Where We Manage</div>
        <h2 class="tw-section-title">Cecil County coverage, <em>town by town.</em></h2>
        <p class="tw-section-lede">We cover the whole county &mdash; the head-of-bay waterfront, the Susquehanna shore, and the Pennsylvania-line north. Each town carries its own association mix.</p>
      </div>
      <div class="tw-geo-neighbors">
        {cities.map((ct) => (
          <a href="/hoa-management/maryland" class="tw-geo-neighbor">
            <div class="tw-geo-neighbor-name">{ct.name}</div>
            <div class="tw-geo-neighbor-meta" set:html={ct.meta}></div>
            {ct.tag && <span class="tw-geo-neighbor-tag">{ct.tag}</span>}
          </a>
        ))}
      </div>
    </div>
  </section>

  <section class="tw-geo-section linen">
    <div class="tw-container-wide">
      <div class="tw-section-head-left" style="max-width:760px;margin:0 0 12px">
        <div class="tw-eyebrow">What&rsquo;s Different Here</div>
        <h2 class="tw-section-title">Small associations, <em>big water.</em></h2>
        <p class="tw-section-lede">Cecil&rsquo;s stock runs small and close to the water, at a junction where three states&rsquo; rules meet.</p>
      </div>
      <div class="tw-geo-law-grid" style="margin-top:40px">
        <div class="tw-geo-law-card">
          <h3>Waterfront capital items</h3>
          <p>Much of the stock sits on or near water &mdash; the head of the bay, the Elk and North East rivers, the C&amp;D Canal. Bulkheads, piers, boat ramps and shoreline all age on their own schedule, and none of them are cheap. That changes the insurance and reserve conversation at once.</p>
          <div class="tw-geo-law-foot">Head of the Chesapeake</div>
        </div>
        <div class="tw-geo-law-card gold">
          <h3>A three-state junction</h3>
          <p>Owners commute into Delaware and Pennsylvania, vendors cross state lines, and boards routinely field questions that assume the wrong state&rsquo;s rules apply. Keeping Maryland law in front is part of the job here.</p>
          <div class="tw-geo-law-foot">MD · DE · PA</div>
        </div>
        <div class="tw-geo-law-card sage">
          <h3>Right-sized for small boards</h3>
          <p>Smaller associations here are exactly the case our financial-only tier was built for &mdash; a real finance department without full-service overhead, so a small board gets GAAP-compliant books without paying for staffing it doesn&rsquo;t need.</p>
          <div class="tw-geo-law-foot">Financial-only fit</div>
        </div>
      </div>
    </div>
  </section>

  <section class="tw-geo-section cream" style="padding:64px 0">
    <div class="tw-container-wide">
      <div class="tw-section-head-left" style="max-width:760px;margin:0 0 12px">
        <div class="tw-eyebrow">Regional Leadership</div>
        <h2 class="tw-section-title" style="margin:10px 0 14px">Your Delmarva director, <em>backing the local team.</em></h2>
        <p class="tw-section-lede">Cecil is part of our Delmarva portfolio, so your board&rsquo;s dedicated CAM works with a regional director who runs Eastern Shore and Delaware communities day to day.</p>
      </div>
      <div class="tw-geo-manager">
        <div class="tw-geo-manager-avatar">DG</div>
        <div>
          <div class="tw-geo-manager-eyebrow">Delmarva Regional Director</div>
          <div class="tw-geo-manager-name">Don Gentry <span>CMCA&reg;, AMS&reg;, PCAM&reg;</span></div>
          <p class="tw-geo-manager-role">
            Don oversees the Eastern Shore, Ocean City and Delaware portfolio &mdash; <strong>20+ years</strong> across customer service and real estate, with a background as a hotel general manager, building engineer and government contract specialist, and a Community Association Portfolio Manager since 2006. Manager portfolios are capped at 8&ndash;12 communities, so your board works with a dedicated CAM, not a rotating pool.
          </p>
        </div>
        <div style="display:flex;flex-direction:column;gap:8px;min-width:200px">
          <a href="/request-a-proposal" class="tw-btn tw-btn-primary tw-btn-block">Request a proposal &rarr;</a>
          <a href="tel:+14435480191" class="tw-btn tw-btn-outline tw-btn-block">(443) 548-0191</a>
        </div>
      </div>
    </div>
  </section>

  <section id="communities" class="tw-geo-section mist">
    <div class="tw-container-wide">
      <div class="tw-section-head" style="text-align:center;max-width:760px;margin:0 auto">
        <div class="tw-eyebrow">What We Manage</div>
        <h2 class="tw-section-title">The kinds of communities we run <em>across Cecil County.</em></h2>
        <p class="tw-section-lede">Board references available on request &mdash; we&rsquo;d rather you talk to a comparable Cecil board than read about us.</p>
      </div>
      <div class="tw-geo-law-grid" style="margin-top:40px">
        <div class="tw-geo-law-card"><h3>Waterfront associations</h3><p>North East and riverfront communities with bulkheads, piers, and shoreline to plan and reserve for.</p></div>
        <div class="tw-geo-law-card"><h3>Small-town associations</h3><p>Elkton and Chesapeake City communities, including historic-district stock around the C&amp;D Canal.</p></div>
        <div class="tw-geo-law-card"><h3>Single-family HOAs</h3><p>Rising Sun and Perryville communities across the north county and the Susquehanna shore.</p></div>
        <div class="tw-geo-law-card"><h3>Financial-only boards</h3><p>Small self-managed associations that want CPA-led books and audit support without full-service overhead.</p></div>
      </div>
      <div style="display:flex;justify-content:center;margin-top:32px;gap:14px;flex-wrap:wrap">
        <a href="/testimonials" class="tw-btn tw-btn-outline">Read board reviews &rarr;</a>
        <a href="/request-a-proposal" class="tw-btn tw-btn-primary">Get board references &rarr;</a>
      </div>
    </div>
  </section>

  <section class="tw-geo-section linen">
    <div class="tw-container-wide">
      <div class="tw-section-head" style="text-align:center;max-width:760px;margin:0 auto">
        <div class="tw-eyebrow">Services in Cecil County</div>
        <h2 class="tw-section-title">Three service tiers, <em>same local team.</em></h2>
        <p class="tw-section-lede">Pick the level your board needs &mdash; the manager, the response time, and the accreditation stay the same.</p>
      </div>
      <div class="tw-geo-law-grid" style="margin-top:48px">
        <a href="/hoa-management" class="tw-geo-law-card" style="text-decoration:none"><h3>Full Service</h3><p>Financial and full property management: board-meeting attendance, neighborhood inspections, vendor management and on-site oversight, financial controls, and day-to-day operations &mdash; including HR for association employees.</p><div class="tw-geo-law-foot">Full-service details &rarr;</div></a>
        <a href="/hoa-management#tiers" class="tw-geo-law-card gold" style="text-decoration:none"><h3>Flex Service</h3><p>Governance, legal affairs, risk management, maintenance coordination, contracting, and full financial management &mdash; with meetings, inspections, and on-site presence available &agrave; la carte at a set hourly rate.</p><div class="tw-geo-law-foot">Flex tier details &rarr;</div></a>
        <a href="/hoa-management/hoa-financial-management" class="tw-geo-law-card sage" style="text-decoration:none"><h3>Financial Only</h3><p>Strictly financial for self-managed Cecil boards: budgets, reserves, assessment collection, accounts payable and receivable, GAAP-compliant bookkeeping, audit coordination, and resale certificates.</p><div class="tw-geo-law-foot">Financial-only tier &rarr;</div></a>
      </div>
    </div>
  </section>

  <section class="tw-section tw-sol-faq-section">
    <div class="tw-container-wide">
      <div class="tw-sol-faq-grid">
        <div class="tw-sol-faq-head">
          <div class="tw-eyebrow">Cecil County FAQs</div>
          <h2>The county-specific <em>questions</em> we get.</h2>
          <p>For all-purpose HOA questions see our <a href="/faq" style="color:var(--tw-teal-500);text-decoration:underline;text-underline-offset:3px">main FAQ hub</a>.</p>
          <a href="/request-a-proposal" class="tw-btn tw-btn-primary">Ask your own question &rarr;</a>
        </div>
        <FaqAccordion items={countyFaqs} defaultOpen={0} />
      </div>
    </div>
  </section>

  <CTA />
  <Footer />
</BaseLayout>
