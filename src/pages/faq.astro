---
import BaseLayout from '../layouts/BaseLayout.astro';
import Header from '../components/Header.astro';
import Topbar from '../components/Topbar.astro';
import Footer from '../components/Footer.astro';
import FaqHub from '../components/FaqHub.jsx';
import { faqSchema, breadcrumbSchema } from '../lib/schema';
import { SITE } from '../config/site';

const faqItems = [
  { q: 'What does an HOA management company actually do?', a: 'A professional HOA management company handles the operational and financial machinery of running an association so the volunteer board can focus on governance. Day-to-day: financial (bookkeeping, assessment collection, vendor payments, budget, reserve study, audit), operational (vendor management, maintenance, covenant enforcement, ARC review, resident communication), and administrative (board meeting prep, minutes, elections, compliance filings, owner portal). The board sets policy; management executes.' },
  { q: "What\'s an AAMC, and why does it matter?", a: 'The Accredited Association Management Company (AAMC) designation is awarded by the Community Associations Institute (CAI). Fewer than 1% of management companies hold it. To qualify, a company must employ multiple PCAM-credentialed managers, maintain specific financial controls, carry adequate fidelity insurance, and pass a thorough operational audit. Tidewater is AAMC-accredited.' },
  { q: 'How long has Tidewater been around?', a: 'Family-owned since 1989. We manage 450+ communities across the Mid-Atlantic (Maryland, DC, Virginia, Pennsylvania, Delaware, West Virginia). Four offices: Owings Mills (HQ), Columbia Pike, Ocean City, and Delaware.' },
  { q: "What\'s your typical response time?", a: 'Next business day on board email as the standard, and usually faster. After-hours emergencies get a manager callback within 30 minutes via our 24/7 line at (443) 548-0191 — a contractual guarantee, answered by Tidewater managers rather than an answering service.' },
  { q: 'Are your contracts long-term lock-ins?', a: 'No. We do not rely on long auto-renewals or exit fees to keep communities; the term and termination provisions are spelled out in plain language in every proposal, and you can read the standard agreement before you sign anything.' },
  { q: 'What does Tidewater management cost?', a: 'It depends on community size, vendor count, meeting cadence and complexity, so we quote per association rather than publishing a rate card. Request a proposal and you will get a line-item number for your community. Financial-only management is a lower-cost tier for boards that keep running their own operations.' },
  { q: 'How do I log into the Owner Portal?', a: 'Go to portal.tidewaterproperty.com and use the email address your community has on file. If you are a new owner or never set up access, click "First-time login" and enter your property address — we will email you an invitation link.' },
  { q: 'How long does the transition from another company take?', a: 'The notice period in your current management agreement sets the pace. Once notice is served we work to a 30/60/90-day transition plan covering records, bank accounts, vendor assignment and the first reporting cycle; self-managed communities usually move faster because there is no outgoing company to wait on.' },
];

const schemas = [
  faqSchema(faqItems),
  breadcrumbSchema([
    { name: 'Home', url: SITE.url + '/' },
    { name: 'Resources', url: SITE.url + '/resources' },
    { name: 'FAQ', url: SITE.url + '/faq' },
  ]),
];
---
<BaseLayout
  title="HOA Management FAQ — Frequently Asked Questions | Tidewater"
  description="Common questions from HOA boards and homeowners about Tidewater management — CINC portal access, proposal evaluation, covenant enforcement, and more."
  pageSchema={schemas}
>
  <style is:global>
    /* ensure React island styles reach DOM */
  </style>
  <Topbar variant="default" />
  <Header activeNav="resources" />
  <FaqHub client:load />
  <Footer />
</BaseLayout>
